PORT=3000

# Clave que la app Flutter debe enviar en el header x-api-key.
# Invéntate una cadena larga y aleatoria; debe coincidir con
# lib/core/backend_config.dart en la app.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ---- Moderación de las respuestas de los colaboradores (sin costo) ----
# Los modelos de imagen corren en este servidor y se descargan la primera
# vez (~250 MB). Necesita `ffmpeg` instalado para revisar videos.
# Por defecto (estricta) una respuesta con foto/video que no se puede
# verificar se rechaza. Pon 0 solo para permitirlas sin verificar.
# MODERACION_ESTRICTA=1
# Sensibilidad (0 a 1; más bajo = más estricto).
# MODERACION_UMBRAL_NSFW=0.6
# MODERACION_UMBRAL_VIOLENCIA=0.6
# Carpeta donde se guardan los modelos descargados.
# MODELOS_IA_DIR=./modelos_ia

# Correo de contacto que se envía a los servicios gratuitos de mapas
# (política de uso de OpenStreetMap).
# CONTACTO_GEOCODIFICACION=desarrollador.inspector@servialco.com
