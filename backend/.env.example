PORT=3000

# Clave que la app Flutter debe enviar en el header x-api-key.
# Invéntate una cadena larga y aleatoria; debe coincidir con
# lib/core/backend_config.dart en la app.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Pagos por PSE (Wompi) — ver la sección "Pagos por PSE" del README para
# cómo sacar las llaves de sandbox (gratis, sin trámites) o de
# producción (cuenta de comercio real). Sin estas dos, el pago con PSE
# no funciona (el resto de la app sigue funcionando igual).
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Solo hace falta si configuras el webhook de Wompi (requiere HTTPS);
# mientras tanto la app confirma el pago por polling directo a Wompi.
WOMPI_EVENTS_SECRET=
