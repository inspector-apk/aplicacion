PORT=3000

# Clave que la app Flutter debe enviar en el header x-api-key.
# Invéntate una cadena larga y aleatoria; debe coincidir con
# lib/core/backend_config.dart en la app.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Detección de IA en fotos de respuesta (opcional): cuenta gratuita en
# https://sightengine.com — ver backend/README.md. Si se dejan vacías,
# esa función simplemente no funciona (el resto del backend sigue igual).
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
