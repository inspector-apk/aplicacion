PORT=3000

# Cuenta que envía los correos. Debe ser una "contraseña de aplicación"
# de Gmail (o de Outlook/Office365), no la contraseña normal de la cuenta.
# Gmail: activa verificación en 2 pasos y genera una en
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Clave que la app Flutter debe enviar en el header x-api-key.
# Invéntate una cadena larga y aleatoria; debe coincidir con
# lib/core/backend_config.dart en la app.
API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
