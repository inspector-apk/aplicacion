[Unit]
Description=Backend de solicitudes compartidas - Inspector
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/inspector-verificacion
EnvironmentFile=/opt/inspector-verificacion/.env
ExecStart=/usr/bin/node /opt/inspector-verificacion/server.js
Restart=always
RestartSec=5
User=inspector
Group=inspector
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
