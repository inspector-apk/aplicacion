# Ambiente de PRUEBAS en tu PC (no producción). Copia este archivo a
# .env.pruebas y arráncalo con:  npm run pruebas
PORT=3100

# Clave solo para pruebas (distinta a la de producción). La app debe
# compilarse con --dart-define=INSPECTOR_API_KEY=<esta misma clave>.
API_KEY=cambia-esta-clave-de-pruebas

# Base de datos separada: nunca toca solicitudes.db.
DB_ARCHIVO=solicitudes_pruebas.db

# Rechaza conexiones que no vengan de la red local.
SOLO_RED_LOCAL=1

# Si en tu PC no hay ffmpeg o fallan los modelos de IA, deja pasar
# fotos/videos sin verificar en vez de rechazarlos.
MODERACION_ESTRICTA=0
