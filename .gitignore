.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# android/ se versiona (permisos, íconos, config de red); sus archivos
# locales y generados los excluye android/.gitignore.
android/build/
android/app/build/
android/.kotlin/
ios/
linux/
macos/
windows/
web/
*.iml
*.class
.idea/

# Artefactos de build, incluido el APK: no se versiona porque lleva
# dentro la API key de producción y el repo es público.
build/

# Backend: nunca versionar secretos, dependencias ni la base de datos local.
backend/.env
backend/node_modules/
backend/*.db
backend/*.db-shm
backend/*.db-wal

backend/modelos_ia/

# Ambiente de pruebas local (tiene la clave de pruebas).
backend/.env.pruebas
